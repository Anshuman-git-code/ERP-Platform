NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://ops_user:devpassword123@localhost:5432/ops_erp?schema=public"

# JWT — use a strong random secret in production (min 64 chars)
JWT_SECRET=replace_with_strong_random_secret_min_64_chars
JWT_EXPIRES_IN=8h

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Winston log level: error | warn | info | debug
LOG_LEVEL=info
