# ============================================================
# FILE: backend/.env.example
# CONSTRUCTION ORDER: #7
# HOW: Created by hand with `touch .env.example`, then edited.
#      Immediately after, the developer copies it:
#        cp .env.example .env
#      and fills in real values in .env.
# WHY NOW: Created before writing any code because:
#   1. Every piece of code that reads from process.env needs to know
#      what variable names to use — this file documents them all.
#   2. .env is in .gitignore (secrets must never be committed).
#      .env.example IS committed — it serves as the documentation
#      and template for every developer who clones the repo.
#   3. New developers can set up the project by running:
#        cp .env.example .env  (then edit .env with real values)
#      without needing to know which env vars are required.
# ============================================================

# ── Node.js environment ────────────────────────────────────────────────────────
# NODE_ENV controls behaviour throughout the application:
#   - logger.ts: "production" → JSON logs, "development" → colorized logs
#   - prisma.ts: "development" → logs all queries to console
#   - index.ts: "production" → refuses to start if JWT_SECRET is the dev default
#   - app.ts: trust proxy setting behaviour
NODE_ENV=development

# ── Server port ────────────────────────────────────────────────────────────────
# The port the Express server listens on.
# In Docker, the container runs on 4000 and is mapped to 4002 on the host.
# In production (ECS), the container runs on 4000 behind the ALB.
PORT=4000

# ── PostgreSQL connection string ───────────────────────────────────────────────
# Full Prisma connection URL. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# During local development, this points to the Dockerized PostgreSQL on port 5444
# (mapped from container port 5432 in docker-compose.yml).
# ?schema=public means Prisma uses the "public" schema inside the database.
#
# In production, this is stored as an AWS SSM SecureString parameter and injected
# into the ECS container at startup by the task execution role.
# It is NEVER hardcoded in source code or committed to git.
DATABASE_URL="postgresql://ops_user:devpassword123@localhost:5432/ops_erp?schema=public"

# ── JWT configuration ─────────────────────────────────────────────────────────
# JWT_SECRET — the secret key used to sign and verify JSON Web Tokens.
# REQUIREMENTS FOR PRODUCTION:
#   - Minimum 64 characters (shorter secrets are weaker against brute-force)
#   - Cryptographically random (not a human-readable phrase)
#   - Unique per environment (dev, staging, prod must each have different secrets)
#   - Rotated periodically
# Generate a strong secret with: openssl rand -base64 64
# In production this comes from AWS SSM Parameter Store, not this file.
JWT_SECRET=replace_with_strong_random_secret_min_64_chars

# JWT_EXPIRES_IN — how long a token is valid after it is issued.
# "8h" = 8 hours. After this time, the token is rejected with "Token expired."
# and the user must log in again.
# Format: jsonwebtoken library — "60" (seconds), "2d" (days), "8h" (hours)
JWT_EXPIRES_IN=8h

# ── CORS origin ────────────────────────────────────────────────────────────────
# The URL of the frontend application that is allowed to make cross-origin requests.
# The browser enforces CORS — only requests FROM this origin are allowed.
# In development: http://localhost:3000 (React dev server)
# In production: the ALB DNS name or custom domain
# In docker-compose: http://localhost:3002 (frontend container on port 3002)
CORS_ORIGIN=http://localhost:3000

# ── Logging ────────────────────────────────────────────────────────────────────
# Controls the minimum log level Winston outputs.
# Values (from most to least verbose): debug → info → warn → error
# "debug": logs every database query (useful in development)
# "info":  logs requests, startup messages, and warnings (production default)
# "error": only logs errors (used during tests in setup.ts to suppress noise)
LOG_LEVEL=info
